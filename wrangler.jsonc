// Cloudflare Workers (static assets): Workers Builds runs `npm run build`, then `npx wrangler deploy`.
// Build-time API address: set VITE_API_URL under the Worker's Settings → Build → Variables.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mon-ecole",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/students/42, ...) fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
