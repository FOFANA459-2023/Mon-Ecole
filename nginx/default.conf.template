server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API and uploaded files (local storage only) go to the backend.
    # The upstream receives its own host name (not the visitor's Host header), so list it in the API's ALLOWED_HOSTS.
    location ~ ^/(api|media)/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        client_max_body_size 12m;
        proxy_read_timeout 120s;
    }

    # Fingerprinted build output: cache for a year.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The app shell must always be revalidated so users get new releases.
    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Client-side routes (/students/42, /settings/users, …) all load the SPA.
    location / {
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
